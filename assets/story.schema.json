{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide Studio story",
  "type": "object",
  "required": [
    "slides"
  ],
  "properties": {
    "language": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "job",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "reported",
              "inferred",
              "proposed",
              "illustrative",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
